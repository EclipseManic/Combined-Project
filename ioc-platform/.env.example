# IOC Lookup Platform local configuration
# Copy to .env, then add the API keys you have.

# Local server and SQLite database
DATABASE_URL=sqlite+aiosqlite:///./data/ioc_platform.db
HOST=127.0.0.1
PORT=8000
BASE_URL=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
ALLOW_NETWORK_BIND=false
DEBUG=false
RELOAD=false
DISABLE_AUTO_OPEN=0
LOG_LEVEL=INFO
CACHE_DIR=
REDIS_URL=

# ── API key sources ─────────────────────────────────────────────────────────
# Priority: (1) this file, (2) the system/process environment as a fallback.
# In this file you may paste the real key OR reference another variable
# (defined later in this file, or in the system env):
#   VT_API_KEY=your_actual_key
#   VT_API_KEY=${MY_VT_KEY}    # fetch MY_VT_KEY (.env first, then system env)
#   VT_API_KEY=my_vt_key       # bare reference to another variable

# Threat-intelligence credentials. This file wins over the process
# environment for every value (.env -> system env -> empty).
VT_API_KEY=
VT_RATE_PER_MINUTE=4
AbuseDB_API_KEY=             # AbuseIPDB; ABUSEIPDB_API_KEY and ABUSH_CH_AUTH_KEY also accepted
ABUSEIPDB_API_KEY=
ABUSH_CH_AUTH_KEY=           # shared abuse.ch key for MalwareBazaar, ThreatFox and URLhaus
MB_AUTH_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=
# AbstractAPI issues one key per product and rejects a key issued for another
# product with 401. Each line below unlocks exactly one adapter.
IPQUALITY_API_KEY=          # IPQualityScore: one key unlocks phone, IP and email
ABSTRACTAPI_EMAIL_KEY=      # AbstractAPI (email)  -> emailreputation.abstractapi.com

ABSTRACTAPI_IP_KEY=           # AbstractAPI IP      -> ip-intelligence.abstractapi.com
ABSTRACTAPI_No_KEY=           # AbstractAPI Phone   -> phoneintelligence.abstractapi.com
                               #   (ABSTRACTAPI_PHONE_KEY is accepted as an alias)
HUNTERIO_API_KEY=

URL_SCAN_API_KEY=
TRIAGE_API_KEY=
HA_API_KEY=
GREYNOISE_API_KEY=
# EMAILREP_API_KEY is not used by the current adapter registry.

OTX_API_KEY=                 # ALIENVAULT_OTX_KEY also accepted
ALIENVAULT_OTX_KEY=
SHODAN_API_KEY=
CENSYS_API_KEY=              # legacy id:secret format; PATs are also accepted
IPINFO_API_KEY=              # IPINFO_ACCESS_TOKEN also accepted
IPINFO_ACCESS_TOKEN=
NVD_API_KEY=
ETHERSCAN_API_KEY=
HUDSON_API_KEY=              # Optional Hudson Rock Cavalier API key

CHAIN_BUSE_API=
FILESCAN_API_KEY=

# Optional enrichment keys/features
HASHLOOKUP_ENABLED=true
ETHERSCAN_PAGE_ENRICHMENT=true   # scrape etherscan.io address page (labels, holdings, multichain); false = API only

# Optional app-level security settings (single-user local: leave empty, HOST stays 127.0.0.1)
API_KEYS=
FAIL_FAST_MISSING_KEYS=false
TRUSTED_HOSTS=
REQUIRE_NETWORK_TLS=true
TRUST_PROXY=false
TRUSTED_PROXY_HOSTS=
ALLOW_GLOBAL_FEEDBACK=false

# Safety controls. Keep active network actions disabled unless explicitly needed.
ENABLE_ACTIVE_PORT_SCAN=false
ENABLE_URL_CONTENT_FETCH=false
ENABLE_PUBLIC_URL_SUBMISSION=false
WEBHOOKS_ENABLED=false
WEBHOOK_SECRET_KEY=

MAX_BATCH_IOCS=100
MAX_CONCURRENT_LOOKUPS=4
MAX_PENDING_LOOKUPS=32


# Independent orchestration deadlines (seconds)
IOC_TIMEOUT=60
BATCH_DEADLINE_SECONDS=300
IOC_DEADLINE_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=20
QUEUE_WAIT_TIMEOUT_SECONDS=10
NETWORK_TIMEOUT_SECONDS=15

# History retention: lookup results and orphaned IOC rows older than this
# many days are purged by the periodic cleanup job (default 30, min 1).
HISTORY_RETENTION_DAYS=30

# Optional privacy/OPSEC allowlist. Leave empty to use all available sources.
# Example: ENABLED_SOURCES=OpenPhish,URLhaus,Tor Exit,StopForumSpam
ENABLED_SOURCES=

# Optional scoring overrides
SCORING_OVERRIDE_MIN_WEIGHT=1.2
SCORING_OVERRIDE_COUNT_HIGH=2
SCORING_OVERRIDE_COUNT_MEDIUM=1
